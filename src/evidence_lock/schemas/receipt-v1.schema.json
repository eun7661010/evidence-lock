{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eun7661010/evidence-lock/v0.1.0/src/evidence_lock/schemas/receipt-v1.schema.json",
  "title": "evidence-lock receipt v1",
  "description": "A portable snapshot of source, artifact, and policy hashes with an optional human or AI review decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "receipt_version",
    "created_at",
    "snapshot_id",
    "evidence",
    "review"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/eun7661010/evidence-lock/v0.1.0/src/evidence_lock/schemas/receipt-v1.schema.json"
    },
    "receipt_version": {
      "const": "evidence-lock/receipt/v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256Identifier"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "artifacts", "policies"],
      "properties": {
        "sources": {
          "$ref": "#/$defs/evidenceList"
        },
        "artifacts": {
          "$ref": "#/$defs/evidenceList"
        },
        "policies": {
          "$ref": "#/$defs/evidenceList"
        }
      }
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256Identifier": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size", "files"],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "kind": {
          "enum": ["file", "directory"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewer_type",
        "decision",
        "reviewed_at",
        "summary",
        "review_id"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewer_type": {
          "enum": ["human", "ai"]
        },
        "decision": {
          "enum": ["approved", "rejected"]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1000
        },
        "review_id": {
          "$ref": "#/$defs/sha256Identifier"
        }
      }
    }
  }
}
